# Non-secret values inlined into the client bundle by `next build` (and so by
# `opennextjs-cloudflare build`). Loaded for production builds only; `next dev`
# ignores this file. Secrets live in Worker secrets, never here.

# Live v2 push hub (workers/live-hub). The hub admits browsers from
# https://clippers.lukeghanna.com only (ALLOWED_ORIGINS), so other hosts fall
# back to polling /api/live.
NEXT_PUBLIC_LIVE_HUB_URL=wss://live.lukeghanna.com
