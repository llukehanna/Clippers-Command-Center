# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# BALLDONTLIE API key (get from balldontlie.io)
BALLDONTLIE_API_KEY=your_api_key_here

# TheOdds API key (get from the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# Public origin of the app (server pages fetch their own API through it)
# Production: https://clippers.lukeghanna.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Secret for authenticating manual calls to /api/cron/poll-live (generate with: openssl rand -hex 32)
CRON_SECRET=your_cron_secret_here

# Rate limit delay in milliseconds between BDL API requests.
# Free tier (5 req/min): use 12000. ALL-STAR tier (60 req/min): use 1000.
# Local BDL script rate-limit delay.
DELAY_MS=12000

# Live v2 push hub (Cloudflare Worker, workers/live-hub). Leave blank → no push; /live polls /api/live.
# LIVE_HUB_URL: https origin the runner + cron route publish to (production: https://live.lukeghanna.com).
# LIVE_HUB_SECRET: the hub's shared secret (see workers/live-hub/README.md).
# NEXT_PUBLIC_LIVE_HUB_URL: wss origin browsers connect to; production value lives in .env.production.
LIVE_HUB_URL=
LIVE_HUB_SECRET=
NEXT_PUBLIC_LIVE_HUB_URL=
